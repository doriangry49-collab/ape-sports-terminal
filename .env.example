# ==============================================================================
# Sports Intelligence Engine — Environment Configuration
# ==============================================================================
# Note: The engine is designed to run with NO API keys configured by default.
# All paths have sensible local defaults relative to the project root.

ENVIRONMENT=development
LOG_LEVEL=INFO

# Storage paths (relative to project root or absolute)
SPORTS_ENGINE_DATA_DIR=data
SPORTS_ENGINE_BRONZE_DIR=data/bronze
SPORTS_ENGINE_SILVER_DIR=data/silver
SPORTS_ENGINE_GOLD_DIR=data/gold
SPORTS_ENGINE_DUCKDB_PATH=data/sports_engine.duckdb

# Timezone (default is UTC)
DEFAULT_TIMEZONE=UTC

# Optional future API keys (NOT required for bootstrap or local operations)
# API_FOOTBALL_KEY=
# RAPIDAPI_KEY=
